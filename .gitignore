node_modules
.env
.bridge-agent-state.json

# Agent state files (local only)
agents/shared/watercooler-state.json
agents/shared/bulletin.json
agents/shared/processed-tasks.json
agents/shared/channel-map.json
agents/shared/approval-queue.json
data/delivery-quotes.json

# Memory data files (local only)
memory/*.json
package-lock.json

# LLM provider verdict counter (local runtime state)
agents/shared/llm-metrics.json

# Local model weights and binaries - NEVER commit these.
# Ollama stores models under its own data dir (default ~/.ollama), not the repo,
# but these patterns stop a stray pull or export from landing in git.
*.gguf
*.safetensors
*.bin
*.pt
*.onnx
models/
.ollama/

# Claude Code home directory for the container. Holds a LIVE OAuth credential
# (.credentials.json) and .claude.json. NEVER commit — this is a public repo.
.claude-home/

# Editor/script backups. A stray copy of .env would land here as .env.bak.
*.bak

# auto-update.js writes this next to the repo. Sibling of .bridge-agent-state.json,
# which was already ignored; this one was not.
.auto-update-state.json
