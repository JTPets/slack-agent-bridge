node_modules
.bridge-agent-state.json

# The environment file and EVERY copy of it. INVERSE rule, like agents/*/memory/*
# below, and for the same reason: an allowlist of today's names fails open.
# LOGIC CHANGE 2026-10-02 (WORK-TODO #62): `.env` alone matched only the exact name,
# so a vim swap copy of the live file (`.env.swo`, found untracked and NOT ignored in
# the deploy directory on 2026-10-01), `.env.local` and `.env.backup` were each one
# `git add -A` from a public commit. Ignore the family; re-include the template.
.env*
!.env.example

# Editor swap files and local overrides, for any file. A swap file is a full copy of
# whatever was open - on this box that has been `.env` and `agents.json`.
*.sw[a-p]
*.local

# The live WORK_DIR. On the NAS, /share/CACHEDEV1_DATA/jt-agent/work is bind-mounted
# at /tmp/bridge-agent (operator `docker inspect`, 2026-10-01), so the task lock, the
# task queue and every preserved scratch clone - each with its own package.json and
# .git - sit inside this working tree. Root-anchored: nothing tracked lives there.
/work/

# Agent state files (local only). INVERSE rule since 2026-10-02: agents/shared/ holds
# two seeded files and a growing set of runtime state, and a hand copy of state
# (`channel-map.json.pre-rebuild`, found 2026-10-01) matched none of the names below.
# Ignore the directory's contents; re-include the seeds by name. The explicit lines
# that follow are now redundant with the family rule and are kept because they name
# what lives here (tests/agent-activation.test.js asserts two of them).
agents/shared/*
!agents/shared/staff.json
!agents/shared/daily-tasks-template.json
agents/shared/watercooler-state.json
agents/shared/bulletin.json
agents/shared/processed-tasks.json
agents/shared/channel-map.json
# Workspace activation decisions. Gitignored ON PURPOSE: a tracked status field was
# destroyed twice by auto-update's `git reset --hard HEAD`, and an activation is a
# fact about THIS workspace, not about the repository.
agents/shared/agent-activation.json
agents/shared/approval-queue.json
data/delivery-quotes.json

# Memory data files (local only)
memory/*.json

# Agent tiered memory (agents/<id>/memory/). INVERSE rule by design.
#
# The old `memory/*.json` line above is root-anchored and never covered these -
# they were untracked only because nobody ran `git add`. An explicit allowlist of
# the tier filenames we know today (working/short-term/long-term/archive/.migrated)
# would FAIL OPEN: lib/memory-tiers.js exports both a generic writer
# (saveMemoryFile) and a path builder (getAgentMemoryPath), and the agent id is
# whatever agents.json says, so any new tier or any new caller lands a live
# runtime file in git silently. The owner's rule is "no live runtime memory
# reaches the repo, EVER", so the default is ignore-everything and the SEEDED
# files are re-included by name. A new tier file is ignored without anyone
# remembering to add a rule.
#
# Re-included below: the seeded config agents read on boot. Untracking these
# would delete seed data, so they stay tracked deliberately.
agents/*/memory/*
!agents/*/memory/.gitkeep
!agents/*/memory/context.json
!agents/*/memory/backlog.json
!agents/*/memory/rules.json

# LLM provider verdict counter (local runtime state)
agents/shared/llm-metrics.json

# Local model weights and binaries - NEVER commit these.
# Ollama stores models under its own data dir (default ~/.ollama), not the repo,
# but these patterns stop a stray pull or export from landing in git.
*.gguf
*.safetensors
*.bin
*.pt
*.onnx
models/
.ollama/

# Claude Code home directory for the container. Holds a LIVE OAuth credential
# (.credentials.json) and .claude.json. NEVER commit — this is a public repo.
.claude-home/

# Editor/script backups. A stray copy of .env would land here as .env.bak.
*.bak

# auto-update.js writes this next to the repo. Sibling of .bridge-agent-state.json,
# which was already ignored; this one was not.
.auto-update-state.json

# Written by scripts/backup-status.sh from host cron into the deploy checkout and read by
# lib/backup-watch.js (WORK-TODO #42). Runtime state, never tracked. The temp file the
# script renames from is covered too.
/.backup-status.json
/.backup-status.json.tmp.*
.npm-global/
*.bak*
.deploy_key*

# The deployment definition. Off-box copy: docker-compose.example.yml (tracked).
# Ignored so `git clean -fd` in the deploy directory cannot delete it — WORK-TODO #26.
docker-compose.yml
