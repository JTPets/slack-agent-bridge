# Slack Agent Bridge - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets

# ============================================
# REQUIRED - Must be set for the agent to run
# ============================================

# Slack bot OAuth token (xoxb-...). NEVER log this.
# Required scopes: channels:history, channels:read, channels:manage, channels:join,
#                  chat:write, reactions:write, reactions:read, users:read
# Configure scopes at: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-token-here

# Channel ID for #claude-bridge (task intake channel)
BRIDGE_CHANNEL_ID=C0123456789

# Channel ID for #sqtools-ops (operations/status channel)
OPS_CHANNEL_ID=C0123456789

# ============================================
# OPTIONAL - Have sensible defaults
# ============================================

# Default GitHub organization for repo clones
# Default: jtpets
GITHUB_ORG=jtpets

# Path to claude CLI binary.
# The bridge runs in the `jt-agent` container (node:20), where the CLI lives at
# /usr/local/bin/claude. The old Raspberry Pi path (/home/jtpets/.local/bin/claude)
# is dead - a stale value here fails every LLM call with ENOENT.
# Default: /usr/local/bin/claude
CLAUDE_BIN=/usr/local/bin/claude

# Slack polling interval in milliseconds
# Default: 30000 (30 seconds)
POLL_INTERVAL_MS=30000

# ---- Socket Mode (ADDITIVE - slash commands only) ----
#
# Slack APP-LEVEL token (xapp-...). NEVER log this. This is NOT the bot token:
# generate it at api.slack.com/apps -> your app -> Basic Information -> App-Level
# Tokens, with the `connections:write` scope, and enable Settings -> Socket Mode.
#
# LEAVING THIS UNSET IS A SUPPORTED STATE. The bridge starts and runs normally
# without it; the HTTP poll loop above is unchanged and remains the only path a
# TASK:/ASK: message arrives on. An absent token is logged and posted to
# #sqtools-ops once, and nothing else happens. A xoxb- value here is refused on
# shape rather than used.
#
# Default: unset (Socket Mode off)
SLACK_APP_TOKEN=

# How long the Socket Mode connection may be down before it is reported to
# #sqtools-ops. The report repeats once per interval while the outage persists,
# and a recovery line is posted when it comes back - the library reconnects on its
# own but never tells anyone when reconnecting has stopped working.
# Default: 300000 (5 minutes)
SOCKET_MODE_DOWN_ALERT_MS=300000

# Maximum Claude Code turns per task
# Default: 50
MAX_TURNS=50

# Task execution timeout in milliseconds
# Default: 600000 (10 minutes)
TASK_TIMEOUT_MS=600000

# Timeout for installing a scratch clone's own dependencies, before the LLM runs.
# Separate from TASK_TIMEOUT_MS so a hung install cannot eat the turn allowance; a
# timeout is reported as a harness failure. Raise if a slow network causes false failures.
# Default: 300000 (5 minutes)
INSTALL_TIMEOUT_MS=300000

# Base directory for temporary repo clones
# Default: /tmp/bridge-agent
WORK_DIR=/tmp/bridge-agent

# ============================================
# AUTO-UPDATE - For auto-update.js daemon
# ============================================

# Path to the local repository for auto-updates, as seen by the process that runs
# auto-update.js. On the NAS the repo is at /share/CACHEDEV1_DATA/jt-agent on the
# host; set this to whatever that path is inside the container.
# The default below is the dead Raspberry Pi path and is almost certainly wrong
# for your host - set it explicitly.
# Default: /home/jtpets/jt-agent
LOCAL_REPO_DIR=/home/jtpets/jt-agent

# Git polling interval for updates in milliseconds
# Default: 300000 (5 minutes)
CHECK_INTERVAL_MS=300000

# DRAIN-ONE: how long the pending-update marker ($WORK_DIR/.update-pending) may go
# unrefreshed before the bridge treats it as an orphan, clears it and reports it.
# This is a HEARTBEAT, not a ceiling: a live updater refreshes the marker on every
# check interval, so a marker this quiet belongs to a process that is gone. There is
# NO ceiling on how long an update may wait, and an update is never forced.
# Default: 4 x CHECK_INTERVAL_MS (20 minutes at the default interval)
# UPDATE_PENDING_STALE_MS=1200000

# There is no PM2_PROCESS_NAME any more. auto-update.js used to shell out to
# `pm2 restart $PM2_PROCESS_NAME`; the `jt-agent` container has no pm2 binary, so
# that failed with ENOENT on every update and returned before saving the new
# commit hash - re-pulling and re-failing every check interval, permanently.
#
# The restart is now auto-update exiting with code 0. The container runs with
# `restart: unless-stopped`, so the supervisor re-runs
# `npm install && node bridge-agent.js`. No env var configures this.
#
# Because auto-update tracks main, merging to main deploys within
# CHECK_INTERVAL_MS. Before it exits it parse-checks every entry point and
# confirms npm install succeeded; if either fails it reverts to the commit that
# was running, reports to #sqtools-ops, and stays up. That check is what stands
# between a bad merge and a container that restarts into failure forever.

# ============================================
# GOOGLE CALENDAR - For calendar integration
# ============================================

# Option 1: Service account authentication
# Path to Google service account JSON key file
# GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account.json

# Option 2: OAuth authentication (requires all three)
# GOOGLE_CALENDAR_REFRESH_TOKEN=your-refresh-token
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Comma-separated list of calendar IDs to fetch events from
# Default: primary (the user's primary calendar)
# GOOGLE_CALENDAR_IDS=primary,work@group.calendar.google.com

# ---------------------------------------------------------------------------
# SCHEDULED INBOX CHECK (email-monitor `check-inbox` job)
# Both have working defaults; set only to override.
# ---------------------------------------------------------------------------
# How far back a check looks when no successful check is on record (ms, 24h default)
# EMAIL_CHECK_MAX_LOOKBACK_MS=86400000
# Max messages fetched per check
# EMAIL_CHECK_MAX_RESULTS=50

# ============================================
# LLM PROVIDERS - For multi-provider support
# ============================================

# LLM provider to use (default: claude)
# Options: claude, gemini, ollama, openai (not yet implemented)
# LLM_PROVIDER=claude

# Per-agent provider override. Wins over the agent's llm_provider in agents.json
# and the global LLM_PROVIDER above. <AGENTID> is the agent id upper-cased with
# non-alphanumerics replaced by _ (e.g. code-bridge -> LLM_PROVIDER_CODE_BRIDGE).
# Set it here in .env (gitignored) so it survives auto-update's git reset --hard;
# editing agents.json directly on the box is silently discarded on the next pull.
# LLM_PROVIDER_BRIDGE=claude
# LLM_PROVIDER_CODE_BRIDGE=ollama

# Google Gemini API key (required if using gemini provider)
# Get from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# Fallback chain. Single provider or comma-separated. When unset, the default
# chain depends on the primary: ollama -> gemini -> claude, everything else -> gemini.
# LLM_FALLBACK_PROVIDER=gemini,claude

# Set to false to disable automatic fallback entirely (default: enabled)
# LLM_FALLBACK_ENABLED=true

# --- Ollama (local model server) -------------------------------------------
# Required for the ollama provider. There is NO default model name - a call
# without this (and without a per-agent llm_model) fails its precondition check.
# OLLAMA_MODEL=qwen3:8b

# Ollama server base URL. Loopback by design - the model server must never be
# reachable off-box. See CLAUDE.md for the systemd drop-in that enforces this.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# How long the model stays resident in RAM after a request (default: 5m)
# OLLAMA_KEEP_ALIVE=5m

# Context window in tokens (default: 8192)
# OLLAMA_NUM_CTX=8192

# Per-request timeout in ms, used when the caller passes none (default: 120000)
# OLLAMA_TIMEOUT_MS=120000

# Thinking mode: false (default), true, or a level: low | medium | high | max
# OLLAMA_THINK=false

# --- LLM verdict counter ----------------------------------------------------
# Where the per-call provider verdict counter is persisted.
# Default: agents/shared/llm-metrics.json (gitignored local state)
# LLM_METRICS_FILE=agents/shared/llm-metrics.json

# Days of verdict history to keep (default: 30)
# LLM_METRICS_RETENTION_DAYS=30

# ============================================
# HTTPSMS - Primary SMS provider (free)
# ============================================
# Uses owner's Android phone with httpSMS app installed.
# Customers see real local phone number. No monthly cost.
# Get API key at: https://httpsms.com

# httpSMS API key (required for SMS features). NEVER log this.
# HTTPSMS_API_KEY=your-httpsms-api-key-here

# Phone number with httpSMS app installed (+1234567890 format)
# HTTPSMS_PHONE_NUMBER=+1234567890

# ============================================
# CONVERSATION MODE - For natural language processing
# ============================================

# Enable natural conversation mode (default: false)
# When true, the bot will process casual messages without TASK:/ASK: prefixes
# When false (default), only strict TASK:/ASK: formatted messages are processed
# NATURAL_CONVERSATION_MODE=false
